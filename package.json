{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "npm run test:foundation && npm run test:recovery && npm run test:product",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:native": "vite build --config vite.native.config.ts",
    "build:native:dev": "vite build --config vite.native.config.ts --mode development",
    "preview:native": "vite preview --config vite.native.preview.config.ts",
    "verify:native": "node scripts/verify-native-bundle.mjs",
    "test:foundation": "npm exec --prefix api-server -- tsx --tsconfig tsconfig.json --test src/shared/runtime/runtime-config.test.ts src/shared/api/http-client.test.ts src/shared/platform/platform-adapter.test.ts",
    "test:recovery": "npm exec --prefix api-server -- tsx --tsconfig tsconfig.json --test src/features/agent-create-recovery/api.test.ts src/features/password-recovery/api.test.ts src/features/password-recovery/recovery-state.test.ts src/features/password-recovery/validation.test.ts",
    "test:product": "npm exec --prefix api-server -- tsx --tsconfig tsconfig.json --test src/features/immersive-voice-interview/hooks/voice-experience-state.test.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/server/server.js",
    "api:dev": "cd api-server && npm run dev",
    "api:install": "cd api-server && npm install",
    "infra:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ensure-local-postgres.ps1",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-dev.ps1 dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-dev.ps1 build",
    "tauri:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-dev.ps1 icon"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "supabase": "^2.109.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.3"
  }
}
