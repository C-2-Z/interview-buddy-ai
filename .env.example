# Supabase - from project dashboard
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="your_supabase_url"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_PAT="your_supabase_personal_access_token"

# Vite client-side vars
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="your_supabase_url"

# Public client runtime. Web may leave VITE_API_URL empty for same-origin proxying.
# Native builds require an absolute URL; production Native builds require HTTPS.
VITE_API_URL="http://localhost:3001"
# Optional now; set to an app deep-link callback after Capacitor/Tauri shells are initialized.
VITE_AUTH_REDIRECT_URL=""

# DeepSeek API Key (get from https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY="sk-your_deepseek_api_key"

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-your_openai_api_key"

# Anthropic API Key (get from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"

# Qwen voice interview (ASR + TTS)
# The API key and both concrete websocket endpoints are required for voice mode.
# Replace {WorkspaceId}; placeholder endpoints are intentionally reported as blocked.
AI_BAILIAN_API_KEY="your_aliyun_bailian_api_key"
QWEN_ASR_URL="wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime"
QWEN_TTS_URL="wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime"
QWEN_ASR_MODEL="qwen3-asr-flash-realtime"
QWEN_TTS_MODEL="qwen3-tts-flash-realtime"
QWEN_TTS_VOICE="Cherry"
QWEN_ASR_SAMPLE_RATE="16000"
QWEN_TTS_SAMPLE_RATE="24000"
VOICE_WS_TOKEN_SECRET="your_voice_websocket_hmac_secret"
# Set to 1 only for local UI testing without calling Qwen.
VOICE_MOCK_QWEN="0"

# Progressive generation and low-latency rollout
# Use a native Redis/Valkey TCP endpoint in the same US region as the API.
VOICE_VERBOSE_LOGS="0"
AI_INTERACTIVE_TIMEOUT_MS="45000"

# LangGraph Interview Agent (server only)
# Keep disabled until the business migration and explicit checkpoint setup both succeed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ezmock"
# 仅本地开发且没有 PostgreSQL 时可显式启用；production 环境会忽略该开关。
AGENT_ALLOW_MEMORY_CHECKPOINTER=0
AGENT_INTERVIEW_ENABLED="0"
# Agent 2.0 独立发布门；关闭时即使默认版本写成 v2 也会安全回落到 v1。
AGENT_CHECKPOINT_SCHEMA="langgraph"
AGENT_PROMPT_VERSION="agent-v3"
AGENT_EVENT_RETENTION_DAYS="90"
AGENT_MAX_NODE_RETRIES="2"
AGENT_WEB_RESEARCH_ENABLED="1"
AGENT_WEB_RESEARCH_TIMEOUT_MS="30000"
AGENT_QWEN_WEB_SEARCH_MODEL="qwen-plus"
# Set to 0 only when both Tavily and the no-key Wikimedia fallback must be disabled.
AGENT_PUBLIC_WEB_RESEARCH_ENABLED="1"
TAVILY_API_KEY=""
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""

# Optional isolated PostgreSQL URL used only by Agent checkpoint integration tests.
AGENT_TEST_DATABASE_URL=""

# Encryption key for storing user API keys at rest (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_character_hex_encryption_key"

# Optional comma-separated exact origins for Capacitor/Tauri or extra Web deployments.
# Wildcards are rejected. Keep this variable on the API server only.
CORS_ALLOWED_ORIGINS="https://localhost,tauri://localhost"
