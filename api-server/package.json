{
  "name": "interview-buddy-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "test": "npm run test:voice && npm run test:config && npm run test:model-provider && npm run test:readiness && npm run test:knowledge && npm run test:agent",
    "test:config": "tsx --test src/config/cors.test.ts",
    "test:model-provider": "tsx --test src/modules/model-providers/model-provider.service.test.ts",
    "test:readiness": "tsx --test src/modules/agent-readiness/agent-readiness.service.test.ts src/modules/agent-readiness/agent-readiness.routes.test.ts",
    "test:voice": "tsx --test src/modules/voice/qwen-realtime.client.test.ts src/modules/voice/voice-protocol.service.test.ts src/modules/voice/voice-token.service.test.ts src/modules/interview-agent/voice-bridge/voice-bridge.service.test.ts",
    "test:knowledge": "tsx --test src/modules/knowledge/knowledge.integration.test.ts",
    "test:agent": "tsx --test src/modules/interview-agent/agent-v3.migration.test.ts src/modules/interview-agent/roles/personas.test.ts src/modules/interview-agent/interview-agent.config.test.ts src/modules/interview-agent/events/agent-event-stream.test.ts src/modules/interview-agent/graph/interview-agent.graph.test.ts src/modules/interview-agent/graph/checkpointer.integration.test.ts src/modules/interview-agent/graph/input-guard.test.ts src/modules/interview-agent/input/input.repository.test.ts src/modules/interview-agent/runtime/question-runtime.service.test.ts src/modules/interview-agent/evaluation/evaluation.service.test.ts src/modules/interview-agent/report/report.service.test.ts src/modules/interview-agent/audit/agent-run.service.test.ts src/modules/interview-agent/workspace/workspace.repository.test.ts src/modules/interview-agent/interview-agent.repository.test.ts src/modules/interview-agent/interview-agent.service.test.ts src/modules/interview-agent/providers/web-search.provider.test.ts src/modules/interview-agent/providers/production-agent-model.provider.test.ts src/modules/interview-agent/tools/capability-blueprint.test.ts src/modules/interview-agent/tools/question-selector.test.ts src/modules/interview-agent/tools/research.service.test.ts src/modules/interview-agent/tools/preparation.service.test.ts src/modules/interview-agent/tools/preparation.repository.test.ts src/modules/interview-lifecycle/interview-lifecycle.service.test.ts src/modules/agent-memory/agent-memory.service.test.ts src/modules/agent-orchestration/agent-orchestration.service.test.ts",
    "test:coverage:acceptance": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/modules/agent-orchestration/agent-orchestration.service.ts --test-coverage-include=src/modules/agent-readiness/agent-readiness.service.ts --test-coverage-include=src/modules/interview-agent/interview-agent.service.ts --test-coverage-include=src/modules/interview-agent/graph/input-guard.ts --test-coverage-include=src/modules/interview-agent/evaluation/evaluation.service.ts --test-coverage-include=src/modules/interview-agent/report/report.service.ts src/modules/agent-orchestration/agent-orchestration.service.test.ts src/modules/agent-readiness/agent-readiness.service.test.ts src/modules/interview-agent/interview-agent.service.test.ts src/modules/interview-agent/graph/input-guard.test.ts src/modules/interview-agent/evaluation/evaluation.service.test.ts src/modules/interview-agent/report/report.service.test.ts",
    "agent:checkpoint:setup": "tsx src/modules/interview-agent/graph/setup-checkpoint.ts",
    "agent:checkpoint:cleanup-legacy": "tsx scripts/cleanup-legacy-agent-checkpoints.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/lib/skills','dist/lib/skills',{recursive:true,filter:s=>!s.endsWith('.ts')})\"",
    "start": "node dist/serve.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.6.1",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/tavily": "^1.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "hono": "^4.7.6",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.22.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
